# .env file

# --- AI Model Configuration ---
# This is the single variable to control your reasoning model.
# Options: phi3, tinyllama, deepseek-coder:1.3b
OLLAMA_LLM_MODEL=mixtral:8x7b-instruct

# --- Service Configuration ---
OLLAMA_EMBED_MODEL=nomic-embed-text
QDRANT_COLLECTION=isc2_toronto_v3

# --- AI Prompt Configuration ---
#LLM_SYSTEM_PROMPT="You are a helpful assistant for the (ISC)² Toronto Chapter. Your tone should be friendly and concise. Base your answer ONLY on the information within the provided CONTEXT. If the CONTEXT does not contain the information to answer the QUESTION, you must say 'I do not have enough information to answer this question.'"
LLM_SYSTEM_PROMPT="You are a strict data extraction engine. Your only function is to analyze the user's QUESTION and extract the answer from the provided CONTEXT. Format your answer to precisely match the user's question. For example, if the user asks for a list, provide only a numbered list. Do not add any extra words, summaries, or explanations. If the CONTEXT is insufficient, you MUST say 'I do not have enough information to answer this question.'"

